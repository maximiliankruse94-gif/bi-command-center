# Vorlage für Google-Login (BICC_AUTH_MODE=oidc). NIEMALS echte Werte ins Git einchecken!
# In Produktion als Secret in Google Secret Manager speichern und nach /home/appuser/.streamlit/secrets.toml mounten (eigener Ordner, damit .streamlit/config.toml erhalten bleibt).
[auth]
redirect_uri = "https://IHRE-DOMAIN/oauth2callback"
cookie_secret = "LANGER-ZUFAELLIGER-WERT"          # z.B. python -c "import secrets;print(secrets.token_urlsafe(48))"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
